	partition FactCommitLink = m
		mode: import
		source =
					let
						Source = Csv.Document(
							File.Contents(GoldFolder & "\fact_commit_link.csv"),
							[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
						),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Cleaned = Table.ReplaceValue(
							Promoted,
							"",
							null,
							Replacer.ReplaceValue,
							Table.ColumnNames(Promoted)
						),
						Typed = Table.TransformColumnTypes(
							Cleaned,
							{
								{"commit_id", type text},
								{"deployment_id", type text},
								{"project_sk", type text},
								{"lead_time_hours", type number},
								{"is_linkable", type logical},
								{"is_valid_lead_time", type logical},
								{"grain", type text},
								{"deployed_date", type date},
								{"reporting_month", type text}
							}
						),
						WithTimestamps = Table.TransformColumns(
							Typed,
							{
								{"author_date", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(_)), type datetime},
								{"deployed_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(_)), type datetime}
							}
						)
					in
						WithTimestamps

	annotation PBI_ResultType = Table
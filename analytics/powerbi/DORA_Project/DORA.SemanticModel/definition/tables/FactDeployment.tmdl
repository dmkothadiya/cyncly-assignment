	partition FactDeployment = m
		mode: import
		source =
					let
						Source = Csv.Document(
							File.Contents(GoldFolder & "\fact_deployment.csv"),
							[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
						),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Cleaned = Table.ReplaceValue(
							Promoted,
							"",
							null,
							Replacer.ReplaceValue,
							Table.ColumnNames(Promoted)
						),
						Typed = Table.TransformColumnTypes(
							Cleaned,
							{
								{"deployment_id", type text},
								{"project_sk", type text},
								{"component_name", type text},
								{"pipeline_id", type text},
								{"duration_minutes", type number},
								{"deployment_date", type date},
								{"reporting_month", type text},
								{"project_name", type text},
								{"is_mapped", type logical}
							}
						),
						WithTimestamps = Table.TransformColumns(
							Typed,
							{
								{"pipeline_start_time", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(_)), type datetime},
								{"pipeline_end_time", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(_)), type datetime}
							}
						)
					in
						WithTimestamps

	annotation PBI_ResultType = Table
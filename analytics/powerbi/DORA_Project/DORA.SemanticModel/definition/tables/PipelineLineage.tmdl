table PipelineLineage
	lineageTag: 0c4249e3-579e-5b9b-afc2-c177ee06964d

	column layer
		dataType: string
		lineageTag: 2c90e852-eb82-5018-81d6-218a2ce732a5
		summarizeBy: none
		sourceColumn: layer

		annotation SummarizationSetBy = Automatic

	column table_name
		dataType: string
		lineageTag: e574a786-d34e-5774-97a7-ed7e4b185eb2
		summarizeBy: none
		sourceColumn: table_name

		annotation SummarizationSetBy = Automatic

	column rows_in
		dataType: int64
		lineageTag: f5b03e37-15fb-5612-aa73-e594262fa6d4
		summarizeBy: none
		sourceColumn: rows_in

		annotation SummarizationSetBy = Automatic

	column rows_out
		dataType: int64
		lineageTag: 740885b5-3ec7-50b1-b43f-cefc654635e3
		summarizeBy: none
		sourceColumn: rows_out


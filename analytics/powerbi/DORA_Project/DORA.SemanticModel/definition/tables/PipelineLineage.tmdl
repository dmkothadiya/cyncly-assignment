	column rule
		dataType: string
		lineageTag: 236d9cf6-2592-56bb-a36f-d6d32487f9b8
		summarizeBy: none
		sourceColumn: rule

		annotation SummarizationSetBy = Automatic

	partition PipelineLineage = m
		mode: import
		source =
					let
						Source = Csv.Document(
							File.Contents(GoldFolder & "\pipeline_lineage.csv"),
							[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
						),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Cleaned = Table.ReplaceValue(
							Promoted,
							"",
							null,
							Replacer.ReplaceValue,
							Table.ColumnNames(Promoted)
						),
						Typed = Table.TransformColumnTypes(
							Cleaned,
							{
								{"layer", type text},
								{"table_name", type text},
								{"rows_in", Int64.Type},
								{"rows_out", Int64.Type},
								{"rows_dropped", Int64.Type},
								{"rule", type text}
							}
						)
					in
						Typed

	annotation PBI_ResultType = Table
	measure 'Rows Reaching Gold' = CALCULATE ( SUM ( PipelineLineage[rows_out] ), PipelineLineage[layer] = "Gold" )
		lineageTag: 42bb4b9b-2f5b-53e2-9b47-7ceac75f7d09
		formatString: #,0

	partition FactIncident = m
		mode: import
		source =
					let
						Source = Csv.Document(
							File.Contents(GoldFolder & "\fact_incident.csv"),
							[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
						),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Cleaned = Table.ReplaceValue(
							Promoted,
							"",
							null,
							Replacer.ReplaceValue,
							Table.ColumnNames(Promoted)
						),
						Typed = Table.TransformColumnTypes(
							Cleaned,
							{
								{"workitem_id", type text},
								{"project_sk", type text},
								{"project_name", type text},
								{"caused_by_deployment", Int64.Type},
								{"restore_hours", type number},
								{"reporting_month", type text}
							}
						),
						WithTimestamps = Table.TransformColumns(
							Typed,
							{
								{"started_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(_)), type datetime},
								{"resolved_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(_)), type datetime}
							}
						)
					in
						WithTimestamps

	annotation PBI_ResultType = Table
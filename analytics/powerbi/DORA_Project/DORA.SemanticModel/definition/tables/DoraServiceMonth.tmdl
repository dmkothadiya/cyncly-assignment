	partition DoraServiceMonth = m
		mode: import
		source =
					let
						Source = Csv.Document(
							File.Contents(GoldFolder & "\dora_service_month.csv"),
							[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
						),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Cleaned = Table.ReplaceValue(
							Promoted,
							"",
							null,
							Replacer.ReplaceValue,
							Table.ColumnNames(Promoted)
						),
						Typed = Table.TransformColumnTypes(
							Cleaned,
							{
								{"project_sk", type text},
								{"project_name", type text},
								{"reporting_month", type text},
								{"grain", type text},
								{"days_in_month", Int64.Type},
								{"deployment_count", Int64.Type},
								{"deployment_frequency_per_day", type number},
								{"lead_time_median_hours", type number},
								{"lead_time_sample_size", Int64.Type},
								{"lead_time_available", type logical},
								{"lead_time_status", type text},
								{"failed_deployments", Int64.Type},
								{"change_failure_rate_pct", type number},
								{"mttr_median_hours", type number},
								{"mttr_sample_size", Int64.Type},
								{"mttr_available", type logical},
								{"mttr_status", type text},
								{"mttr_all_incidents_hours", type number},
								{"mttr_all_incidents_sample", type number},
								{"median_build_minutes", type number},
								{"metrics_observed", Int64.Type},
								{"data_quality_status", type text},
								{"status_reason", type text},
								{"notes", type text}
							}
						),
						WithDate = Table.AddColumn(Typed, "month_start", each Date.FromText([reporting_month] & "-01"), type date)
					in
						WithDate

	annotation PBI_ResultType = Table
	measure 'Deployments' = SUM ( DoraServiceMonth[deployment_count] )
		lineageTag: ee67923f-27bc-583b-9600-13cb55941452
		formatString: #,0

	measure 'Active Months' = DISTINCTCOUNT ( DoraServiceMonth[reporting_month] )
		lineageTag: 3174dd23-c789-509b-971d-6841bbaf688e
		formatString: #,0

	measure 'Failed Deployments' = SUM ( DoraServiceMonth[failed_deployments] )
		lineageTag: 9bdc057b-1dd3-54d4-989f-744893494aeb
		formatString: #,0

	measure 'Deployment Frequency (per day)' = DIVIDE ( [Deployments], SUM ( DoraServiceMonth[days_in_month] ) )
		lineageTag: ffc8eee9-3fe3-5870-96c1-bc4a4a0d7a8a
		formatString: 0.00

	measure 'Deployment Frequency (per project-month)' = DIVIDE ( [Deployments], COUNTROWS ( DoraServiceMonth ) )
		lineageTag: b18cd233-b5e0-5e3b-9672-a47458c30c00
		formatString: 0.0

	measure 'Lead Time for Changes (median h)' = CALCULATE ( MEDIAN ( FactCommitLink[lead_time_hours] ), FactCommitLink[is_valid_lead_time] = TRUE (), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[project_sk] ), FactCommitLink[project_sk] ) ), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[reporting_month] ), FactCommitLink[reporting_month] ) ) )
		lineageTag: aed6cf63-7001-5096-9288-1596e0bdaa35
		formatString: 0.0 "h"

	measure 'Lead Time Sample' = CALCULATE ( COUNTROWS ( FactCommitLink ), FactCommitLink[is_valid_lead_time] = TRUE (), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[project_sk] ), FactCommitLink[project_sk] ) ), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[reporting_month] ), FactCommitLink[reporting_month] ) ) )
		lineageTag: b2c84af3-192a-5746-a33c-1d00dc9a5821
		formatString: #,0

	measure 'Commit Link Coverage %' = DIVIDE ( CALCULATE ( COUNTROWS ( FactCommitLink ), FactCommitLink[is_valid_lead_time] = TRUE (), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[project_sk] ), FactCommitLink[project_sk] ) ) ), CALCULATE ( COUNTROWS ( FactCommitLink ), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[project_sk] ), FactCommitLink[project_sk] ) ) ) )
		lineageTag: 13fe59ab-1b94-5729-92cd-2ebe19437f22
		formatString: 0.0%

	measure 'Change Failure Rate %' = DIVIDE ( [Failed Deployments], [Deployments] )
		lineageTag: ca9f5dcc-1732-5212-a360-389877f0cc64
		formatString: 0.00%

	measure 'Deployment Related Incidents' = CALCULATE ( COUNTROWS ( FactIncident ), FactIncident[caused_by_deployment] = 1, KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[project_sk] ), FactIncident[project_sk] ) ), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[reporting_month] ), FactIncident[reporting_month] ) ) )
		lineageTag: 738ff983-74e6-5773-a5c9-2e07fad76cae
		formatString: #,0

	measure 'MTTR (median h)' = CALCULATE ( MEDIAN ( FactIncident[restore_hours] ), FactIncident[caused_by_deployment] = 1, KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[project_sk] ), FactIncident[project_sk] ) ), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[reporting_month] ), FactIncident[reporting_month] ) ) )
		lineageTag: ae9b3b88-658f-580e-9aff-82214ec22f61
		formatString: 0.0 "h"

	measure 'MTTR Sample' = CALCULATE ( COUNTROWS ( FactIncident ), FactIncident[caused_by_deployment] = 1, KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[project_sk] ), FactIncident[project_sk] ) ), KEEPFILTERS ( TREATAS ( VALUES ( DoraServiceMonth[reporting_month] ), FactIncident[reporting_month] ) ) )
		lineageTag: c59d37a7-0b5d-5bbd-9f65-3a38c2e60512
		formatString: #,0

	measure 'Sample Size Note' = "Lead time n=" & FORMAT ( [Lead Time Sample], "#,##0" ) & "  |  MTTR n=" & FORMAT ( [MTTR Sample], "#,##0" ) & "  |  Link coverage " & FORMAT ( [Commit Link Coverage %], "0.0%" )
		lineageTag: ec7bde7b-346d-52a3-b54f-a388e4160e8f

	measure 'Data Quality Status' = IF ( ISBLANK ( [Lead Time for Changes (median h)] ) || ISBLANK ( [MTTR (median h)] ), "Partial - see caveats", "Validated" )
		lineageTag: c06c6012-fb33-5c70-8993-36ad18b42dbe
